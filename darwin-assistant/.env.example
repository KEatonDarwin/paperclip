# ── Claude (local binary — subscription auth, no API key needed) ─────────────
# Path to the claude CLI binary (default: resolves via PATH)
# CLAUDE_BIN=/usr/local/bin/claude

# ── Paperclip ────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://paperclip:paperclip@192.168.1.52:5432/paperclip
PAPERCLIP_API_URL=http://localhost:3100
# Create a board API key in Paperclip → Settings → API Keys
PAPERCLIP_BOARD_API_KEY=pk_...

# ── Slack ─────────────────────────────────────────────────────────────────────
# Bot token (xoxb-...) — from OAuth & Permissions
SLACK_BOT_TOKEN=xoxb-...
# App-level token (xapp-...) — from Basic Information → App-Level Tokens (requires connections:write scope)
SLACK_APP_TOKEN=xapp-...
# Kevin's Slack user ID — for daily briefing DMs (find it in Slack: click your name → View full profile → More → Copy member ID)
SLACK_KEVIN_USER_ID=U...

# ── SHIM (Somehow I Manage) MCP connection ───────────────────────────────────
SHIM_MCP_URL=https://somehow.thedarwinhub.com/mcp
# Bearer token if SHIM MCP requires auth (check your SHIM server config)
# SHIM_MCP_TOKEN=

# ── Google Calendar (via gog CLI — must be logged in via `gog auth login`) ───
# Google account to use with gog (defaults to kevineatonfx@gmail.com)
# GOG_ACCOUNT=kevineatonfx@gmail.com
# Calendar ID to write events to (defaults to "primary")
# GOG_CALENDAR_ID=primary

# ── Voice Intake (Apple Watch → JARVIS) ──────────────────────────────────────
# OpenAI API key — used for Whisper speech-to-text (~$0.006/min)
# OPENAI_API_KEY=sk-...
# Pre-shared bearer token for authenticating voice requests from the watch
# Generate one: openssl rand -hex 32
# JARVIS_VOICE_TOKEN=

# ── Server ────────────────────────────────────────────────────────────────────
WEBHOOK_PORT=3200
